# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agnistrot?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
# Use a long, random string — e.g. openssl rand -hex 64
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────
# Get these from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Set CLOUDINARY_ENABLED=false to skip hoster uploads and OCR from the upload
# buffer directly (self-contained demo/tests). Default (unset) = use Cloudinary.
CLOUDINARY_ENABLED=false

# ── Outbox (event-driven architecture) ────────────────────────────────
# Batch size per worker cycle, retries before the Dead Letter Queue, worker
# poll interval, and the stale-"processing" lease after which a crashed/restarted
# worker's events are re-queued.
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=3
OUTBOX_POLL_MS=30000
OUTBOX_LEASE_MS=300000

# ── CORS (Phase 5) ─────────────────────────────────────────
# Used for CORS whitelist in production. Set to your deployed frontend URL.
# Example: https://agnistrot.vercel.app
# Leave as "*" for development to allow any origin.
FRONTEND_URL=http://localhost:5173
